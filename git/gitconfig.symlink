[user]
	name = Andy Fowler
	email = afowler@nutshell.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICW2m8s1rGgrW3RKIwfTrpbw5gL0vILXgGXExvGNRmRi

[alias]
	st = status -sb
	diffw = diff --word-diff=color
	diffi = diff --ignore-submodules
	co = checkout
	ci = commit
	br = branch
	sub = submodule
	pre = pull --rebase --autostash
	lg = log --graph --pretty=format:'%Cred%h%Creset %C(cyan)%an%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
	tags = tag -l
	push = push --recurse-submodules=check
	branch-s = for-each-ref --sort='-*committerdate' --format="%(refname:short)" refs/heads refs/remotes
	br-s = "! git branch-s"
	recent = ! git reflog | grep 'checkout: moving from' | head -n 50 | egrep -oh ' \\S+$' | awk '!x[$0]++'

[color]
	diff = auto
	status = auto
	branch = auto
	ui = auto

[core]
	editor = vim
	excludesfile = ~/.gitignore

[pager]
	diff = "less -r"

[merge]
	tool = opendiff

[hub]
	protocol = https

[help]
	autocorrect = 1

[push]
	default = current
	autoSetupRemote = true
[blame]
	ignoreRevsFile = .git-blame-ignore-revs
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
; identity, not machine state -- both are inert unless something turns on
; commit.gpgsign, which only ~/.gitconfig.local does.
[gpg]
	format = ssh

; Machine-specific overrides, and the one thing that must NOT be tracked:
; the 1Password signer. gpg.ssh.program is an absolute path into
; /Applications, so hardcoding it here made every box without 1Password
; installed fail at "cannot exec op-ssh-sign / failed to write commit
; object" -- mid-rebase, which is the worst time to find out.
;
; git silently ignores an include whose file is missing, so this is the
; conditional that git config itself doesn't give us: there's no includeIf
; for "hostname" or "this file exists". Boxes with 1Password get the file
; from script/bootstrap and sign; boxes without it simply never turn
; commit.gpgsign on and commit unsigned.
;
; Keep it last so anything in it wins over the settings above.
[include]
	path = ~/.gitconfig.local
