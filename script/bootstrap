#!/bin/sh
#
# bootstrap installs things.

DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles/}"

set -e

echo ''

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

setup_gitconfig () {
  if ! [ -f git/gitconfig.symlink ]
  then
    info 'setup gitconfig'

    user ' - What is your github author name?'
    read git_authorname
    user ' - What is your github author email?'
    read git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" git/gitconfig.symlink.example > git/gitconfig.symlink

    success 'gitconfig'
  fi
}

# Commit signing goes through 1Password's op-ssh-sign, which lives at an
# absolute path under /Applications and isn't on every machine. Tracking it in
# gitconfig.symlink meant a box without 1Password died on every commit with
# "cannot exec op-ssh-sign", so it lives in the untracked ~/.gitconfig.local
# include instead -- absent file, no signing, clean commit.
#
# Only ever writes the file, never removes it: if you've hand-edited
# ~/.gitconfig.local to sign some other way, that's yours to keep.
OP_SSH_SIGN='/Applications/1Password.app/Contents/MacOS/op-ssh-sign'

# Whether op-ssh-sign can actually produce a signature *right now*, rather than
# whether the binary happens to be on disk. Presence is not a good proxy: on a
# Mac you've ssh'd into, /Applications/1Password.app exists and the path
# resolves fine, but the agent socket belongs to the GUI login session, so
# signing dies with "Couldn't get agent socket?" instead. Both end the same
# way -- "failed to write commit object", mid-rebase.
#
# So just try it. A throwaway repo, a real signed empty commit, discard it.
# This may raise a 1Password auth prompt during bootstrap; that's the point.
op_ssh_sign_works () {
  [ -x "$OP_SSH_SIGN" ] || return 1

  signingkey=`git config --get user.signingkey 2>/dev/null`
  [ -n "$signingkey" ] || return 1

  probe=`mktemp -d` || return 1
  git init -q "$probe" 2>/dev/null || { rm -rf "$probe"; return 1; }

  if git -C "$probe" \
       -c user.name=probe -c user.email=probe@localhost \
       -c gpg.format=ssh \
       -c gpg.ssh.program="$OP_SSH_SIGN" \
       -c user.signingkey="$signingkey" \
       -c commit.gpgsign=true \
       commit -q --allow-empty -m probe >/dev/null 2>&1
  then
    rm -rf "$probe"
    return 0
  fi

  rm -rf "$probe"
  return 1
}

setup_git_signing () {
  if [ -f "$HOME/.gitconfig.local" ]
  then
    success 'git signing (~/.gitconfig.local already present)'
    return 0
  fi

  if ! op_ssh_sign_works
  then
    success 'git signing (op-ssh-sign unavailable here, commits stay unsigned)'
    return 0
  fi

  cat > "$HOME/.gitconfig.local" <<EOF
; Machine-local git config. NOT tracked in ~/.dotfiles -- included from
; git/gitconfig.symlink, which git skips silently when this file is absent.
; Regenerated by script/bootstrap when 1Password is installed.
[gpg "ssh"]
	program = $OP_SSH_SIGN
[commit]
	gpgsign = true
EOF

  success 'git signing (1Password found, wrote ~/.gitconfig.local)'
}

link_files () {
  ln -s $1 $2
  success "linked $1 to $2"
}

overwrite_all=false
backup_all=false
skip_all=false

# link_dotfile SOURCE DEST -- symlinks SOURCE to DEST, prompting if DEST is
# already there. Answers of [S]kip/[O]verwrite/[B]ackup all persist across
# every call, so you only get asked once per bootstrap run.
link_dotfile () {
  source="$1"
  dest="$2"

  # tr -s / so a link recorded as ~/.dotfiles//foo still matches ~/.dotfiles/foo;
  # older runs of this script baked in the doubled slash
  if [ -L $dest ] && [ "`readlink $dest | tr -s /`" = "`echo $source | tr -s /`" ]
  then
    success "already linked $dest"
    return
  fi

  if [ -f $dest ] || [ -d $dest ] || [ -L $dest ]
  then

    overwrite=false
    backup=false
    skip=false

    if [ "$overwrite_all" = "false" ] && [ "$backup_all" = "false" ] && [ "$skip_all" = "false" ]
    then
      user "File already exists: $dest, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
      read action

      case "$action" in
        o )
          overwrite=true;;
        O )
          overwrite_all=true;;
        b )
          backup=true;;
        B )
          backup_all=true;;
        s )
          skip=true;;
        S )
          skip_all=true;;
        * )
          ;;
      esac
    fi

    if [ "$overwrite" = "true" ] || [ "$overwrite_all" = "true" ]
    then
      rm -rf $dest
      success "removed $dest"
    fi

    if [ "$backup" = "true" ] || [ "$backup_all" = "true" ]
    then
      mv $dest $dest\.backup
      success "moved $dest to $dest.backup"
    fi

    if [ "$skip" = "false" ] && [ "$skip_all" = "false" ]
    then
      link_files $source $dest
    else
      success "skipped $source"
    fi

  else
    link_files $source $dest
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`
  do
    link_dotfile "$source" "$HOME/.`basename \"${source%.*}\"`"
  done
}

# Anything under config/ mirrors ~/.config, e.g. config/ghostty ->
# ~/.config/ghostty. Whole directories are linked rather than individual
# files, so extra files an app writes alongside its config come along too.
# This exists because the *.symlink convention can only target ~/.<name>:
# naming a file config.symlink would resolve to ~/.config itself and an
# [o]verwrite would rm -rf the entire directory.
install_config_dirs () {
  info 'installing ~/.config entries'

  [ -d "$DOTFILES_ROOT/config" ] || return 0
  mkdir -p "$HOME/.config"

  for source in "$DOTFILES_ROOT"/config/*
  do
    [ -e "$source" ] || continue
    link_dotfile "$source" "$HOME/.config/`basename \"$source\"`"
  done
}

setup_gitconfig
install_dotfiles
install_config_dirs
setup_git_signing

echo ''
echo '  All installed!'
